generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

/// A person who can request access. New accounts stay PENDING until an admin approves them.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING)
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace    Workspace?
  sessions     Session[]

  @@map("users")
}

/// A login. Only the hash of the cookie value is stored. The cookie itself is httpOnly.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

/// One person's saved checks. `tokenHash` remains from when workspaces were anonymous; logins use Session now.
model Workspace {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  /// Null on rows created before accounts existed. Those checks are not attached to anyone.
  userId     String?  @unique @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  checks     Check[]

  @@map("workspaces")
}

/// One saved check. `doc` holds everything except the per-reference results, which live in CheckResult.
model Check {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// When the check ran, as the browser reported it. Lists are ordered by this.
  checkedAt   DateTime      @map("checked_at") @db.Timestamptz(3)
  doc         Json
  /// What lists and the dashboard show, rebuilt on every write.
  summary     Json
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set when the check is deleted, so the deletion can be undone.
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  results     CheckResult[]

  @@index([workspaceId, deletedAt, checkedAt(sort: Desc)])
  @@map("checks")
}

/// The outcome for one reference. `kind` is "results", or "refResults" for the reference list of an uploaded draft.
model CheckResult {
  checkId String @map("check_id") @db.Uuid
  kind    String
  idx     Int
  verdict String
  data    Json
  check   Check  @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@id([checkId, kind, idx])
  @@index([checkId, kind, verdict])
  @@map("check_results")
}
