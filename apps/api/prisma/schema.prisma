generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Where a set of saved checks lives. Every account has one. Workspaces from before accounts were anonymous:
/// a browser held a token for one, and only the token's hash is stored. Signing up or in from that browser
/// moves its checks into the account.
model Workspace {
  id         String   @id @default(uuid()) @db.Uuid
  /// Set only for an anonymous workspace from before accounts.
  tokenHash  String?  @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  checks     Check[]
  user       User?

  @@map("workspaces")
}

enum UserRole {
  user
  super_admin
}

/// pending: signed up, waiting for the super admin to approve. rejected: the super admin declined the sign-up.
enum UserStatus {
  pending
  active
  suspended
  rejected
}

/// An account. The email is stored in lower case; the password only as a scrypt hash.
model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  name            String
  passwordHash    String          @map("password_hash")
  role            UserRole        @default(user)
  status          UserStatus      @default(pending)
  workspaceId     String          @unique @map("workspace_id") @db.Uuid
  workspace       Workspace       @relation(fields: [workspaceId], references: [id])
  /// Where the account was created from, for spotting several accounts made by one person.
  signupIp        String?         @map("signup_ip")
  signupUserAgent String?         @map("signup_user_agent")
  /// Wrong passwords in a row. Enough of them lock the account for a while.
  failedSignIns   Int             @default(0) @map("failed_sign_ins")
  lockedUntil     DateTime?       @map("locked_until") @db.Timestamptz(3)
  suspendedAt     DateTime?       @map("suspended_at") @db.Timestamptz(3)
  /// When the super admin approved or declined the sign-up.
  reviewedAt      DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSignInAt    DateTime?       @map("last_sign_in_at") @db.Timestamptz(3)
  lastSeenAt      DateTime?       @map("last_seen_at") @db.Timestamptz(3)
  sessions        Session[]
  events          ActivityEvent[] @relation("subject")
  actions         ActivityEvent[] @relation("actor")
  usage           UsageDaily[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its hash is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Something that happened to an account: a sign-up, a sign-in, a failed one, or an admin's action.
model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  /// sign_up, sign_up_blocked, sign_in, sign_in_failed, sign_out, locked, suspended, reactivated,
  /// signed_out_everywhere, signups_paused, signups_opened.
  type      String
  /// The account the event is about, when there is one.
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation("subject", fields: [userId], references: [id], onDelete: Cascade)
  /// The admin who did it, for an admin's action.
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  /// The address that was typed, for attempts on an account that does not exist.
  email     String?
  ip        String?
  userAgent String?  @map("user_agent")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("activity_events")
}

/// How many lookups of each kind an account made on a day, and how often it was rate-limited.
model UsageDaily {
  userId String   @map("user_id") @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The calendar day in the stats time zone.
  day    DateTime @db.Date
  /// verify, source, enrich, journals, fulltext, or throttled.
  kind   String
  count  Int

  @@id([userId, day, kind])
  @@index([day])
  @@map("usage_daily")
}

/// Settings an admin can change while the site runs, such as whether new accounts can be made.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// One saved check. `doc` holds everything except the per-reference results, which live in CheckResult.
model Check {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// When the check ran, as the browser reported it. Lists are ordered by this.
  checkedAt   DateTime      @map("checked_at") @db.Timestamptz(3)
  doc         Json
  /// What lists and the dashboard show, rebuilt on every write.
  summary     Json
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set when the check is deleted, so the deletion can be undone.
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  results     CheckResult[]

  @@index([workspaceId, deletedAt, checkedAt(sort: Desc)])
  @@map("checks")
}

/// The outcome for one reference. `kind` is "results", or "refResults" for the reference list of an uploaded draft.
model CheckResult {
  checkId String @map("check_id") @db.Uuid
  kind    String
  idx     Int
  verdict String
  data    Json
  check   Check  @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@id([checkId, kind, idx])
  @@index([checkId, kind, verdict])
  @@map("check_results")
}
