# Copy to .env for local development. `pnpm db:up` starts a Postgres that matches this URL.
DATABASE_URL=postgresql://siyasat:siyasat@localhost:5433/siyasat
PORT=3000

# Your contact address. Crossref gives higher rate limits to requests that carry one, and Unpaywall
# (free PDFs in the reader) requires it.
CONTACT_EMAIL=

# Free key from https://openalex.org. Without it OpenAlex title search is refused most of the time and
# Siyasat falls back to Crossref alone.
OPENALEX_API_KEY=

# Optional: raises Semantic Scholar's rate limit for abstracts.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: the site's public address (e.g. https://siyasat.example), used in link previews.
# Without it, the address each page was requested on is used.
PUBLIC_URL=

# The super admin, who can open the admin dashboard (/admin). The account is created when the API starts,
# and this password always works for it: change it here and restart to change it. At least 12 characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: the time zone the admin dashboard counts days in. Defaults to Asia/Manila.
STATS_TIMEZONE=

# Optional: the AI web search, for references Crossref and OpenAlex cannot find. Leave AI_PROVIDER empty to keep it off.
# anthropic | openai | google | gateway | openai-compatible. See "The optional AI web search" in README.md.
AI_PROVIDER=
# The provider's key (or set ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, AI_GATEWAY_API_KEY).
AI_API_KEY=
# Defaults to claude-opus-5-5 for anthropic; required for the others.
AI_MODEL=
# Required for openai-compatible (e.g. http://localhost:11434/v1 for Ollama).
AI_BASE_URL=
# native (the provider's own search; the default for anthropic, openai and gateway) | tavily | brave
AI_WEB_SEARCH=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# AI web searches per account per day, and for the whole site per day.
AI_DAILY_LIMIT_PER_USER=5
AI_DAILY_LIMIT=20
