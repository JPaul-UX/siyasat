{
  "name": "@siyasat/api",
  "version": "1.0.0",
  "private": true,
  "description": "Siyasat API: looks references up in scholarly databases and stores each workspace's checks.",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "nest start",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "db:migrate": "prisma migrate dev",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/gateway": "^4.0.154",
    "@ai-sdk/google": "^4.0.125",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@siyasat/core": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "ai": "^7.0.181",
    "helmet": "^8.3.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
